generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Пользователи, клиники, доступ ----------

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String          @id @default(uuid())
  login        String          @unique
  passwordHash String
  role         Role
  locale       String          @default("ru")
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  sessions     Session[]
  doctor       DoctorProfile?
  patient      PatientProfile?
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // сам токен нигде не хранится
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Clinic {
  id       String           @id @default(uuid())
  name     String
  doctors  DoctorProfile[]
  patients PatientProfile[]
}

model DoctorProfile {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  displayName String
  patients    DoctorPatient[]
  shares      Share[]
}

enum PatientStatus {
  INVITED
  ACTIVE
  ARCHIVED
}

model PatientProfile {
  id          String          @id @default(uuid())
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id])
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  displayName String
  locale      String          @default("ru")
  contact     String?
  status      PatientStatus   @default(INVITED)
  createdAt   DateTime        @default(now())
  doctors     DoctorPatient[]
  invitations Invitation[]
  intakes     Intake[]
}

model DoctorPatient {
  doctorId  String
  doctor    DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@id([doctorId, patientId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id        String           @id @default(uuid())
  tokenHash String           @unique
  patientId String
  patient   PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
}

// ---------- Разговор и карточка ----------

enum IntakeStatus {
  IN_PROGRESS
  READY
  SHARED
  REVIEWED
}

enum ProcessingStatus {
  IDLE
  PROCESSING
  FAILED
  DONE
}

model Intake {
  id                  String            @id @default(uuid())
  patientId           String
  patient             PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  locale              String
  country             String?
  consentVersion      String
  consentAt           DateTime          @default(now())
  status              IntakeStatus      @default(IN_PROGRESS)
  processingStatus    ProcessingStatus  @default(IDLE)
  urgent              Boolean           @default(false) // срочность — отдельный признак, не статус
  urgentReason        String?
  version             Int               @default(0) // номер текущей версии карточки, 0 — карточки ещё нет
  preview             Json              @default("{}") // живое превью от агента; финальную карточку не трогает
  idempotencyKey      String?
  voiceTokenHash      String?
  voiceConversationId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  messages            Message[]
  cards               CardVersion[]
  translations        CardTranslation[]
  shares              Share[]

  @@unique([patientId, idempotencyKey])
}

model Message {
  id              String   @id @default(uuid())
  intakeId        String
  intake          Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  role            String // patient | assistant
  text            String
  language        String
  clientMessageId String?
  replyToId       String?
  createdAt       DateTime @default(now())

  @@unique([intakeId, clientMessageId])
  @@index([intakeId, createdAt])
}

// Каждая правка создаёт новую версию. Отправленная врачу версия не меняется.
model CardVersion {
  id              String   @id @default(uuid())
  intakeId        String
  intake          Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  version         Int
  sourceLocale    String
  fields          Json
  doctorQuestions Json
  createdAt       DateTime @default(now())

  @@unique([intakeId, version])
}

model CardTranslation {
  id              String   @id @default(uuid())
  intakeId        String
  intake          Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  cardVersion     Int
  locale          String
  fields          Json
  doctorQuestions Json
  machine         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([intakeId, cardVersion, locale])
}

model Share {
  id           String        @id @default(uuid())
  intakeId     String
  intake       Intake        @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  cardVersion  Int
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consentAt    DateTime      @default(now())
  reviewedAt   DateTime?
  notification String        @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  createdAt    DateTime      @default(now())

  @@unique([intakeId, cardVersion, doctorId])
  @@index([doctorId, createdAt])
}

// ---------- Упражнения ----------

model Exercise {
  id            String                @id // короткое имя, например "pf-slow"
  visual        String? // процедурная 3D-сцена во фронте: "hammock" | "mannequin"
  locked        Boolean               @default(false)
  modelUrl      String? // файл модели, если сцена не процедурная
  animationName String?
  durationSec   Int
  sortOrder     Int                   @default(0)
  published     Boolean               @default(false)
  translations  ExerciseTranslation[]
}

// Публикация и проверка специалистом — отдельно для каждого языка.
model ExerciseTranslation {
  exerciseId        String
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  locale            String
  title             String
  description       String
  instructions      Json // string[]
  breathingCues     Json // { atSec: number, phase: string, text: string }[]
  machineTranslated Boolean  @default(false)
  unlockNote        String?
  audioUrl          String?
  contraindications String?
  reviewed          Boolean  @default(false)
  published         Boolean  @default(false)

  @@id([exerciseId, locale])
}
